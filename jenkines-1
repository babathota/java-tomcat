            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Stage 5: Build WAR
        stage('Build WAR') {
            steps {
                echo 'Building the WAR file...'
                // -DskipTests because we already ran tests in Stage 2
                sh 'mvn clean package -DskipTests'
