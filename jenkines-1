pipeline {
    agent { label 'wsl' } 

    environment {
        // The ID of the credential you saved in Jenkins
        SONAR_AUTH_TOKEN = credentials('my-sonar-token') 
    }

    stages {
        // Stage 1: Checkout Code
        stage('Checkout') {
            steps {
                Checkout scm
            }
        }

        stage('ls'){
            steps {
                sh 'ls -la'
            }
        }

        // Stage 2: Unit Testing (The "src/test" part)
        stage('Unit Tests') {
            steps {
                echo 'Running JUnit Tests...'
                // This runs tests inside src/test/java
                // If tests fail, the pipeline STOPS here.
                sh 'mvn test'
            }
            post {
                always {
                    // Shows the test results graph in Jenkins UI
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
