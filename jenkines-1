pipeline {
    agent { label 'wsl' } 
    /*
    environment {
        // The ID of the credential you saved in Jenkins
        SONAR_AUTH_TOKEN = credentials('my-sonar-token') 
    }
    */

    stages {
        // Stage 1: Checkout Code
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('ls'){
            steps {
                sh 'ls -la'
            }
        }              
        
        // Stage 3: SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                // This block connects to the "sonar-docker" config we made earlier
                
                    // The magic command. It pushes code to your Docker SonarQube.
                    // -Dsonar.projectKey = unique name for this project in Sonar
                    /*
                    sh """
                      mvn sonar:sonar \
                      -Dsonar.projectKey=my-java-webapp \
                      -Dsonar.host.url=https://192.168.1.50:9000 \
                      -Dsonar.login=$SONAR_AUTH_TOKEN
                    """
                    
                    sh """ 
                    mvn clean verify sonar:sonar  -Dmaven.test.failure.ignore=true \
                     -Dsonar.projectKey=java-test \
                     -Dsonar.host.url=http://172.29.147.94:9000 \
                     -Dsonar.login=sqp_75036d8c79c16675ae763cedbd0e10b0eeee0a4f \
                     -Dsonar.projectVersion=${env.BUILD_NUMBER}
                    """
                    */
                    sh """ 
                    mvn clean test sonar:sonar  -Dmaven.test.failure.ignore=true \
                     -Dcheckstyle.skip \
                     -Dsonar.projectKey=java-test \
                     -Dsonar.host.url=http://localhost:9000 \
                     -Dsonar.login=sqp_75036d8c79c16675ae763cedbd0e10b0eeee0a4f \
                     -Dsonar.projectVersion=${env.BUILD_NUMBER}
                    """
                 

                }
            
        }        

         stage('Quality Gate') {
            steps {
                script {
                        timeout(time: 15, unit: 'MINUTES') {
                                waitForQualityGate abortPipeline: true  
                           }                    
                    }
                }
            }
    
        


        // Stage 5: Build WAR
        stage('Build WAR') {
            steps {
                echo 'Building the WAR file...'
                // -DskipTests because we already ran tests in Stage 2
                sh 'mvn package -DskipTests -Dcheckstyle.skip'
            }
            post {
                success {
                    // Saves the WAR file so you can download it from Jenkins
                    archiveArtifacts artifacts: 'target/*.war', fingerprint: true
                }
            }
        }
 
    }
}